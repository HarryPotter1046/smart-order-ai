# Copy this file to .env (which is gitignored) and fill in the value.
#   cp .env.example .env
#
# This is the ONLY secret docker-compose passes to n8n as an env var.
# The Anthropic API key and the Supabase service_role key are NOT here — you store those as
# n8n credentials (Header Auth + Custom Auth) inside the n8n UI. See SETUP.md.

# Slack incoming-webhook URL (Slack app → Incoming Webhooks → Add New Webhook to Workspace).
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXXXXXX
